# Sanity — create a project at https://www.sanity.io/manage
# Project ID is the 8-character id. Dataset is usually "production".
# Add http://localhost:3000 and your production origin (https://www.haominluo.com)
# to the project's CORS origins, with credentials allowed for Studio.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Optional. Only needed later for draft preview or server-side mutations.
# SANITY_API_READ_TOKEN=
